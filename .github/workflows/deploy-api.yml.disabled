# =============================================================================
# PARKED - NOT ACTIVE. This workflow does not run.
#
# Why: kod-universe has no separate backend service. The only API is
# app/api/chat/route.ts, a Next.js route handler that deploys to Vercel with
# the frontend (see deploy-web.yml). There is no root api/ directory, no
# Dockerfile, and no database - so none of the secrets below point anywhere.
#
# Kept as a scaffold for when a standalone backend is added.
#
# To re-enable:
#   1. git mv deploy-api.yml.disabled deploy-api.yml
#   2. Uncomment the workflow below (strip the leading "# ").
#   3. Add api/ with a Dockerfile.
#   4. Set secrets: COOLIFY_DEPLOY_WEBHOOK, COOLIFY_API_TOKEN,
#      VPS_HOST, VPS_SSH_USER, VPS_SSH_KEY, DATABASE_URL
#      and vars: DOCKER_NETWORK, RUN_DB_MIGRATIONS
#
# Note: the .disabled extension is what actually keeps this file inert -
# GitHub only parses .yml/.yaml in .github/workflows. A fully commented-out
# .yml file parses to nothing and gets flagged as an invalid workflow file.
# =============================================================================

